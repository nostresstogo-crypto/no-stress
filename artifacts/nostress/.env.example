# Copier ce fichier en .env.local et ajuster les valeurs.
#
# EXPO_PUBLIC_API_BASE
#   URL de base de l'API (sans slash final).
#   - Laisser vide (ou ne pas définir) pour utiliser http://localhost:8080/api (API locale)
#   - Décommenter pour pointer vers l'API de test
#
# EXPO_PUBLIC_API_BASE=https://test.api.no-stress.net/api

# EXPO_PUBLIC_HAS_IMAGE_TRANSFORM
#   Activer le redimensionnement d'images côté serveur (endpoint /storage/transform).
#   Mettre à "true" uniquement si l'API ciblée supporte cet endpoint (API locale Replit).
#   Laisser vide ou false pour l'API test et la production (images servies telles quelles).
#
# EXPO_PUBLIC_HAS_IMAGE_TRANSFORM=true
